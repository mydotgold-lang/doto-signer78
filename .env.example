# REAL values must be set only in your hosting provider.
PORT=8080
DOTONE_RPC_URL=https://rpc.dotone.online
# Optional failover list:
# DOTONE_RPC_URLS=https://rpc.dotone.online
DOTO_CHAIN_ID=505
DOTO_SIGNER_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Exactly 64 hexadecimal characters (32 random bytes).
DOTO_WALLET_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
DOTO_DATA_DIR=./data
